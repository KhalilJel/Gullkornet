NODE_ENV=development
DRY_RUN=true
TARGET_COUNTRY=Norway
TARGET_INDUSTRY=accounting firms
TARGET_CITY=Oslo and Akershus
TARGET_OFFER=website redesign focused on qualified enquiries
DAILY_LEAD_LIMIT=25

# Optional: Google Places API (New) discovery.
# Enable Places API in Google Maps Platform and configure billing before use.
# Keep your real key in .env; never commit it.
GOOGLE_MAPS_API_KEY=

# Gullkornet outbound email. Dry-run is the default; these settings do not send email.
OUTREACH_FROM_EMAIL=jelassi@smartsvar.no
GULLKORNET_ENABLE_LIVE_SEND=false
GULLKORNET_APPROVED_RECIPIENT=
GULLKORNET_RECIPIENT_REVIEWED=false
GULLKORNET_SEND_IDEMPOTENCY_KEY=
RESEND_API_KEY=

# Before any live send, create data/suppressed-emails.txt locally.
# One opted-out/suppressed email per line. Never commit the real list.

# Optional persistent Gullkornet lead registry (separate from SmartSvar)
GULLKORNET_AIRTABLE_BASE_ID=
AIRTABLE_API_TOKEN=
